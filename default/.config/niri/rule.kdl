layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

window-rule {
  draw-border-with-background false
  background-effect {
    blur true
  }
}

window-rule {
  match is-floating=true

  focus-ring {
    off
  }

  shadow {
    on
    softness 20
    spread 3
    offset x=0 y=0
  }
}

// noctaliaの設定ウィンドウをフロートで表示.  
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

window-rule {
  match app-id="float"
  open-floating true
  default-column-width { fixed 1270; }
  default-window-height { fixed 720; }
}
