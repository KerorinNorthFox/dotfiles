animations {
  window-open {
    duration-ms 150
    curve "ease-out-expo"
  }
  window-close {
    duration-ms 150
    curve "ease-out-quad"
  }
  workspace-switch {
    spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
  }
  horizontal-view-movement {
    spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
  }
  window-movement {
    spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
  }
  window-resize {
    spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
  }
}
